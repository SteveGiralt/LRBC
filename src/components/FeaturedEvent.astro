---
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt?: string;
  title: string;
  /** ISO date, e.g. "2026-10-03" */
  date: string;
  /** Display time, e.g. "9:00 – 11:30 AM" */
  time?: string;
  /** ISO date after which the card is hidden; defaults to `date` */
  expires?: string;
  /** Small label above the title */
  eyebrow?: string;
  class?: string;
}
const {
  image,
  alt,
  title,
  date,
  time,
  expires = date,
  eyebrow = "Featured Event",
  class: className = "",
} = Astro.props;

/** Midnight at the end of an ISO date in Montana time, as epoch ms */
function endOfDayMountain(iso: string): number {
  const [y, m, d] = iso.split("-").map(Number);
  const utcMidnight = Date.UTC(y, m - 1, d + 1);
  const offset = new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Denver",
    timeZoneName: "shortOffset",
  })
    .formatToParts(utcMidnight)
    .find((p) => p.type === "timeZoneName")!
    .value.replace("GMT", "");
  return utcMidnight - Number(offset) * 3_600_000;
}

const expiresAt = endOfDayMountain(expires);
const expired = Date.now() >= expiresAt;

// Build the date from its parts so it isn't shifted by the server's timezone
const [y, m, d] = date.split("-").map(Number);
const fullDate = new Date(y, m - 1, d).toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
});
---

{!expired && (
  <section
    class={`scroll-reveal max-w-screen-xl mx-auto px-6 pt-12 ${className}`}
    data-expires-at={expiresAt}
  >
    <article class="bg-sand/50 rounded-xl overflow-hidden border border-sand shadow-sm flex flex-col md:flex-row">
      <!-- Image — shown uncropped, since event graphics often contain text -->
      <div class="md:w-1/2 shrink-0 flex items-center p-4 md:p-6 md:pr-0">
        <Image
          src={image}
          alt={alt ?? title}
          class="w-full h-auto rounded-lg shadow-md"
          quality={85}
          widths={[400, 600, 800, 1024, 1440]}
          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 640px"
        />
      </div>

      <!-- Details -->
      <div class="p-6 md:p-10 flex-1 flex flex-col justify-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">{eyebrow}</p>
        <h2 class="font-serif text-3xl md:text-4xl text-stone mb-3">{title}</h2>
        <div class="w-12 h-0.5 bg-accent mb-5"></div>

        <ul class="space-y-1.5 text-stone/80 mb-5">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <time datetime={date} class="font-medium text-stone">{fullDate}</time>
          </li>
          {time && (
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 mt-0.5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{time}</span>
            </li>
          )}
        </ul>

        <div class="text-stone/80 leading-relaxed space-y-3 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-primary-hover">
          <slot />
        </div>
      </div>
    </article>
  </section>
  <!-- The page is prerendered, so also hide the card in the browser once it expires -->
  <script is:inline>
    (function () {
      var el = document.currentScript.previousElementSibling;
      if (Date.now() >= Number(el.dataset.expiresAt)) el.remove();
    })();
  </script>
)}
